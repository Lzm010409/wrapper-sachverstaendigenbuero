# Datenbank — in Coolify auf die Postgres-Ressource zeigen lassen
DATABASE_URL=postgres://benutzer:passwort@host:5432/werkbank

# Zufallswert, signiert die Sitzungscookies. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITZUNG_GEHEIMNIS=

# Anthropic API — für Bibliothekserweiterung und Ausformulierung
ANTHROPIC_API_KEY=

# autoiXpert — Bearer-Token der externen Schnittstelle.
# Die Basis-URL enthaelt die Version; ohne /v1 laufen alle Pfade ins Leere.
AUTOIXPERT_API_TOKEN=
AUTOIXPERT_BASIS_URL=https://app.autoixpert.de/externalApi/v1

# Abrufregel. Voreinstellung ist die enge Fassung: nur offene Gutachten
# ab Mai 2026, nichts Schreibendes. Bewusst loesen, nicht dauerhaft.
# AUTOIXPERT_NUR_OFFENE=false
# AUTOIXPERT_FRUEHESTENS=2026-05-01T00:00:00.000Z
# AUTOIXPERT_SCHREIBEN=erlaubt

# sevDesk — nur lesend: Zahlungsstand der Rechnungen (Geldampel).
# Der Token wird in sevDesk unter Einstellungen > Benutzer > API-Token
# erzeugt und ohne "Bearer" als authorization-Kopfzeile geschickt.
SEVDESK_API_TOKEN=
# SEVDESK_BASIS_URL=https://my.sevdesk.de/api/v1

# Pipedrive — nur lesend: Phase, Schadenhoehe, sevDesk-Verweis, Notizen, Mails
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_BASE_URL=https://api.pipedrive.com/api/v2
# Notizen und die Mail-Liste eines Deals gibt es bei Pipedrive nur in v1 — deshalb eine zweite Basis.
PIPEDRIVE_BASE_URL_V1=https://api.pipedrive.com/api/v1
# Die einzelne Mail (mit Textkoerper) laeuft nur ueber die eigene Subdomain
# des Kontos, nicht ueber api.pipedrive.com (live geprueft am 08.09.2026 —
# derselbe Aufruf kam ueber api.pipedrive.com als 404 zurueck). Nur der
# Firmenname, ohne ".pipedrive.com".
PIPEDRIVE_COMPANY_DOMAIN=

# Kleinanzeigen — die Beschaffung der Vergleichsfahrzeuge.
# Ohne Angabe beantwortet das Cockpit die Aufrufe selbst (`/api/kleinanzeigen`)
# und vergibt beim Start ein eigenes Zugangswort. Gesetzt werden muss hier
# nichts. Wer stattdessen einen ausgelagerten Dienst benutzen will, traegt
# seine Adresse und seine Zugangsdaten ein:
# KA_API_BASE=https://ka-api.example.de
# KA_API_USER=
# KA_API_PASS=
# Mindestabstand zwischen zwei Abrufen bei Kleinanzeigen, in Millisekunden.
# KLEINANZEIGEN_ABSTAND_MS=1500

# Fotos — Zwischenspeicher fuer Vorschaubilder.
# Ohne Angabe ein Verzeichnis unter /tmp. Vorschaubilder gelten 7 Tage und
# werden nach einem Neustart des Containers neu geholt; das ist gewollt, sie
# sind abgeleitete Daten.
# FOTO_SPEICHER=/var/lib/cockpit/fotos

# --- Belege in den Gutachtenordner (OneDrive über n8n) ---------------------
# Der Webhook des Workflows WBW_Belege_Upload_OneDrive. Fehlt er, sagt der
# Knopf im Cockpit das beim Klick und tut nichts.
N8N_BELEGE_URL=
# Der Wert der n8n-Zugangsdaten „Header Auth account". Geht als
# Authorization-Kopfzeile mit — ohne ihn weist der Workflow die Anfrage ab.
N8N_BELEGE_TOKEN=
