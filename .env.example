# Kopie als .env.local anlegen. Niemals ausgefuellt committen.

# --- autoiXpert (externalApi/v1) ---
# Schluessel unter Einstellungen > Externe API anlegen. Nur die Berechtigungen
# vergeben, die der Wrapper braucht.
AUTOIXPERT_API_KEY=
AUTOIXPERT_BASE_URL=https://app.autoixpert.de/externalApi/v1

# --- Pipedrive (nur lesend: Phase, Kanzlei, Rechnungsverweis) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_BASE_URL=https://api.pipedrive.com/api/v2
PIPEDRIVE_COMPANY_DOMAIN=

# Ohne AUTOIXPERT_API_KEY laeuft die Anwendung im Demomodus mit Beispieldaten.
