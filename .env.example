# Datenbank — in Coolify auf die Postgres-Ressource zeigen lassen
DATABASE_URL=postgres://benutzer:passwort@host:5432/werkbank

# Zufallswert, signiert die Sitzungscookies. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITZUNG_GEHEIMNIS=

# Anthropic API — für Bibliothekserweiterung und Ausformulierung
ANTHROPIC_API_KEY=

# autoiXpert — Bearer-Token der externen Schnittstelle.
# Die Basis-URL enthaelt die Version; ohne /v1 laufen alle Pfade ins Leere.
AUTOIXPERT_API_TOKEN=
AUTOIXPERT_BASIS_URL=https://app.autoixpert.de/externalApi/v1

# Abrufregel. Voreinstellung ist die enge Fassung: nur offene Gutachten
# ab Mai 2026, nichts Schreibendes. Bewusst loesen, nicht dauerhaft.
# AUTOIXPERT_NUR_OFFENE=false
# AUTOIXPERT_FRUEHESTENS=2026-05-01T00:00:00.000Z
# AUTOIXPERT_SCHREIBEN=erlaubt

# Pipedrive — nur lesend: Phase, Schadenhoehe, sevDesk-Verweis
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_BASE_URL=https://api.pipedrive.com/api/v2
